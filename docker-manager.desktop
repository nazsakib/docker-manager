[Desktop Entry]
Name=Docker Manager
GenericName=Container Manager
Comment=Manage local Docker containers (Lightweight, Zero-Overhead)
Exec=sh -c "which google-chrome-stable >/dev/null 2>&1 && google-chrome-stable --app=http://127.0.0.1:4444 || (which google-chrome >/dev/null 2>&1 && google-chrome --app=http://127.0.0.1:4444) || xdg-open http://127.0.0.1:4444"
Icon=docker
Terminal=false
Type=Application
Categories=Development;System;
StartupNotify=true
StartupWMClass=127.0.0.1__4444
